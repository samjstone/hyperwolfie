---
import { getWebmentions } from "../server/getWebmentions";
import type { Webmention } from "../types/webmentions";
import { Heart, Repeat2, MessageCircle } from "@lucide/astro";

const { pageUrl, loading } = Astro.props;

let webmentions = [] as Webmention[];
if (!loading) {
  webmentions = await getWebmentions(pageUrl);
}

const { likes, reposts, replies } = webmentions.reduce(
  (acc, webmention) => {
    switch (webmention["wm-property"]) {
      case "like-of":
        acc.likes.push(webmention);
        break;
      case "repost-of":
        acc.reposts.push(webmention);
        break;
      case "in-reply-to":
        acc.replies.push(webmention);
        break;
    }
    return acc;
  },
  { likes: [], reposts: [], replies: [] } as {
    likes: Webmention[];
    reposts: Webmention[];
    replies: Webmention[];
  }
);
---

{
  /* While the deferred island loads we don't know the real counts yet, so show a
     neutral skeleton chip instead of a misleading "0" that would flip to the real value. */
}
<div class="flex flex-row gap-4 text-theme-blue">
  <div class="flex flex-row items-center gap-1 h-8">
    <MessageCircle class="fill-theme-blue stroke-theme-blue shrink-0" />
    {
      loading ? (
        <span class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse" />
      ) : (
        replies.length
      )
    }
  </div>
  <div class="flex flex-row items-center gap-1 h-8">
    <Repeat2 class="stroke-theme-blue shrink-0" />
    {
      loading ? (
        <span class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse" />
      ) : (
        reposts.length
      )
    }
  </div>
  <div class="flex flex-row items-center gap-1 h-8">
    <Heart class="fill-theme-blue stroke-theme-blue shrink-0" />
    {
      loading ? (
        <span class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse" />
      ) : (
        likes.length
      )
    }
  </div>
</div>
