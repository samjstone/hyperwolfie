---
import type { Webmention } from "../types/webmentions";
import { Heart, Repeat2, MessageCircle } from "@lucide/astro";

interface Props {
  pageUrl: string;
  webmentions?: Webmention[];
}

const { pageUrl, webmentions } = Astro.props;

const counts = webmentions
  ? webmentions.reduce(
      (acc, webmention) => {
        switch (webmention["wm-property"]) {
          case "like-of":
            acc.likes++;
            break;
          case "repost-of":
            acc.reposts++;
            break;
          case "in-reply-to":
            acc.replies++;
            break;
        }
        return acc;
      },
      { likes: 0, reposts: 0, replies: 0 },
    )
  : null;
---

<div
  class="flex flex-row gap-4 text-theme-blue"
  data-webmentions={counts ? undefined : pageUrl}
>
  <div class="flex flex-row items-center gap-1 h-8">
    <MessageCircle class="fill-theme-blue stroke-theme-blue shrink-0" />
    {
      counts ? (
        counts.replies
      ) : (
        <span
          data-count="in-reply-to"
          class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse"
        />
      )
    }
  </div>
  <div class="flex flex-row items-center gap-1 h-8">
    <Repeat2 class="stroke-theme-blue shrink-0" />
    {
      counts ? (
        counts.reposts
      ) : (
        <span
          data-count="repost-of"
          class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse"
        />
      )
    }
  </div>
  <div class="flex flex-row items-center gap-1 h-8">
    <Heart class="fill-theme-blue stroke-theme-blue shrink-0" />
    {
      counts ? (
        counts.likes
      ) : (
        <span
          data-count="like-of"
          class="inline-block h-4 w-3 rounded-xs bg-theme-blue/20 animate-pulse"
        />
      )
    }
  </div>
</div>

<script>
  async function loadCounts(el: HTMLElement) {
    const target = el.dataset.webmentions!;
    let mentions: { "wm-property": string }[] = [];
    try {
      const res = await fetch(
        `/api/webmentions?target=${encodeURIComponent(target)}`,
      );
      if (res.ok) mentions = await res.json();
    } catch {
      // leave counts at 0 if the fetch fails
    }
    el.querySelectorAll<HTMLElement>("[data-count]").forEach((span) => {
      const count = mentions.filter(
        (m) => m["wm-property"] === span.dataset.count,
      ).length;
      span.replaceWith(document.createTextNode(String(count)));
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        loadCounts(entry.target as HTMLElement);
      }
    },
    { rootMargin: "200px" },
  );

  document
    .querySelectorAll<HTMLElement>("[data-webmentions]")
    .forEach((el) => observer.observe(el));
</script>
