---
import type { Webmention } from "../types/webmentions";

interface Props {
  webmentions: Webmention[];
}

const { webmentions } = Astro.props;
---

<div>
  {
    webmentions.map((webmention) => (
      <div class="text-white">
        {webmention.author.name} {webmention.content?.text}
      </div>
    ))
  }
</div>
