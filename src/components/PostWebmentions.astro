---
import { getWebmentions } from "../server/getWebmentions";
import type { Webmention } from "../types/webmentions";

interface Props {
  postId: string;
}

const { postId } = Astro.props;
const webmentions = await Promise.all(
  await getWebmentions(`${Astro.site}${postId}`),
);
---

<div>
  {
    webmentions.length > 0 ? (
      webmentions.map((webmention) => (
        <div>
          {webmention.author.name} {webmention.content?.text}
        </div>
      ))
    ) : (
      <p>No interactions yet...</p>
    )
  }
</div>
