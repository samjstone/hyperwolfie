---
import type { Post } from "../lib/posts";
import PostInteractions from "./PostInteractions.astro";
import { Heart, Repeat2, MessageCircle } from "@lucide/astro";
import Article from "./posts/Article.astro";
import Photo from "./posts/Photo.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
---

<div
  class="chat-bubble h-entry bg-light mb-5 p-3 rounded-xs outline-theme-dark outline-solid relative"
>
  <div class="outline-dotted outline-background p-5 mb-3 rounded-xs">
    <a href={`/${post.id}`}>
      <time
        class="dt-published text-theme-orange"
        datetime={post.data.date.toISOString()}
      >
        {
          post.data.date.toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          })
        }
      </time>
    </a>
    {
      post.postType === "article" ? (
        <Article post={post} />
      ) : post.postType === "photo" ? (
        <Photo post={post} />
      ) : (
        <p class="e-content">{post.body}</p>
      )
    }
  </div>
  <PostInteractions pageUrl={`https://hyperwolfie.com/${post.id}`} server:defer>
    <PostInteractions slot="fallback" loading="true" />
  </PostInteractions>

  <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden="from-humans"></a>
  <a class="p-author h-card hidden" href="https://hyperwolfie.com/">
    HyperWolfie
  </a>
</div>
