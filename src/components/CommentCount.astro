---
interface CommentCountProps {
    postId: string;
}

const { postId } = Astro.props as CommentCountProps;
const isLocalDev = import.meta.env.DEV;
---

<comentario-count
    domain-id={isLocalDev ? "e3e3afd7-409b-42cb-83b3-2f174c1562aa" : "04982b80-07be-4ea4-a151-d4c1a501d132"}
    path={`/${postId}/`}
    placeholder="..."
    error-text="ERR"
    zero-text="[0 Comments]"
    prefix="["
    suffix=" Comment(s)]"></comentario-count>
