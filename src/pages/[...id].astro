---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getFeed } from "../lib/posts";
import PostWebmentions from "../components/PostWebmentions.astro";
import Header from "../components/Header.astro";
import wolfYell from "../assets/images/wolf-yell.gif";
import cloverField from "../assets/images/beautiful-clover-field.jpeg";
import SideNav from "../components/SideNav.astro";
import Post from "../components/Post.astro";

export async function getStaticPaths() {
  const posts = await getFeed();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const pathname = Astro.url.pathname;
---

<Layout>
  <Header
    backgroundSrc={cloverField.src}
    decorationSrc={wolfYell.src}
    text="Blog"
  />
  <div class="flex flex-row gap-10 w-full">
    <SideNav />
    <div class="w-1/2">
    <Post post={post} />
    <div>
      <PostWebmentions
        pageUrl={`https://hyperwolfie.com${pathname}`}
        server:defer
      >
        <div slot="fallback">Loading...</div>
      </PostWebmentions>
    </div>
    </div>
  </div>
</Layout>
