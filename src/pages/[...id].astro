---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getFeed } from "../lib/posts";
import { getWebmentions } from "../server/getWebmentions";
import PostWebmentions from "../components/PostWebmentions.astro";
import Header from "../components/Header.astro";
import wolfYell from "../assets/images/wolf-yell.gif";
import cloverField from "../assets/images/beautiful-clover-field.jpeg";
import SideNav from "../components/SideNav.astro";
import Post from "../components/Post.astro";

const { id } = Astro.params;
const posts = await getFeed();
const post = posts.find((p) => p.id === id);

if (!post) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const webmentions = await getWebmentions(`https://hyperwolfie.com/${post.id}`);
---

<Layout>
  <Header
    backgroundSrc={cloverField.src}
    decorationSrc={wolfYell.src}
    text="Blog"
  />
  <div class="flex flex-row gap-10 w-full">
    <SideNav />
    <div class="w-1/2">
      <div class="mb-2">
        <div
          onclick="window.history.back()"
          class="hover:text-theme-orange/80 font-bold"
        >
          &larr; Back to Blog
        </div>
      </div>
      <Post post={post} webmentions={webmentions} />
      <PostWebmentions webmentions={webmentions} />
    </div>
  </div>
</Layout>
