---
import Layout from '../layouts/Layout.astro';
import { getFeed, getPhotos } from '../lib/posts';

const feed = await getFeed()
---

<Layout>
	<div class="flex flex-col items-center justify-center min-h-screen p-4">
	{feed.map((post) => (
		<div class="border-2 p-2">
			{post.postType === 'photo' && getPhotos(post.data.photo).map((src) => (
				<div class="w-sm">
					<img src={src} alt="" />
				</div>
			))}
			{post.body}
		</div>
	))}
	</div>
</Layout>
