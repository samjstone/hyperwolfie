---
import Layout from "../layouts/Layout.astro";
import wolfieRun from "../assets/images/wolfie-run.gif";
import wolfWalk from "../assets/images/wolf-walk.gif";
import cuteWolf from "../assets/images/cute-wolf-sit.png";
import flowerField from "../assets/images/flower-field.png";
import yellowstoneBackground from "../assets/backgrounds/yellowstone-bg.jpg";
import forestStrip from "../assets/images/forest-strip.png";
import grassField from "../assets/images/grass-field.png";
import waterfall from "../assets/images/waterfall.png";
import wolfPackHowl from "../assets/images/wolf-pack-howl.gif";
import Menu, { type MenuItem } from "../components/Menu.astro";
import DropdownButton from "../components/DropdownButton.astro";

const menuItems: MenuItem[] = [
  {
    title: "About",
  },
  {
    title: "Blog",
    href: "/blog/",
  },
  {
    title: "Art",
  },
  {
    title: "Plushies",
  },
  { title: "Shrines" },
];
---

<Layout styles="p-5 items-center lg:p-20">
  <div
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
    style=`background-image: url(${yellowstoneBackground.src})`
  >
  </div>
  <div class="h-full w-full flex flex-col md:flex-row lg:w-8/12">
    <div
      class="hidden md:block w-3/12 bg-light rounded-sm border-double border-6 border-theme-dark"
    >
      <div
        style={`background-image: url(${cuteWolf.src})`}
        class="h-48 w-full bg-cover bg-no-repeat relative"
      >
        <img
          src={flowerField.src}
          alt="Flower field"
          class="align-bottom absolute bottom-0"
          style="filter: drop-shadow(1px -1px 2px #000000);"
        />
      </div>
      <nav class="p-2 font-macondo flex flex-col mt-3">
        <h2 class="font-fredoka text-theme-blue font-bold text-2xl mb-1">
          Navigation 🐾
        </h2>
        <Menu menuItems={menuItems} styles="text-xl" />
      </nav>
    </div>
    <div class="flex flex-col w-full md:w-9/12">
      <div
        class="flex flex-row items-center justify-center md:justify-start w-full"
      >
        <img src={wolfWalk.src} alt="Wolf running gif" class="h-12 sm:h-18" />
        <h1
          class="font-title text-4xl sm:text-5xl drop-shadow-[2px_2px_3px_rgba(0,0,0,1)] text-theme-orange"
          style="line-height: unset;"
        >
          HYPERWOLFIE
        </h1>
        <img src={wolfWalk.src} alt="Wolf running gif" class="h-12 sm:h-18" />
      </div>
      <div class="w-full sm:hidden">
        <DropdownButton label="Navigation 🐾" id="menu">
          <Menu
            menuItems={menuItems}
            styles="sm:flex sm:menu-horizontal sm:justify-around font-macondo text-xl bg-light w-full border-double border-theme-dark border-x-6 border-t-6"
          />
        </DropdownButton>
      </div>
      <Menu
        menuItems={menuItems}
        styles="hidden md:hidden sm:flex sm:menu-horizontal sm:justify-around font-macondo text-xl bg-light w-full border-double border-theme-dark border-x-6 border-t-6"
      />
      <div class="flex flex-row">
        <main
          class="flex flex-3 flex-col bg-light h-full rounded-r-sm border-6 md:border-0 border-double md:border-y-6 md:border-r-6 border-theme-dark p-3"
        >
          <img
            src={forestStrip.src}
            alt="Forest"
            class="w-full rounded-b-sm self-center"
          />
          <div class="border-3 border-dotted border-theme-dark mt-3 rounded-sm">
            <img
              src={wolfieRun.src}
              class="h-32 float-left m-2"
              alt="wolf running"
            />
            <p class="m-2">
              {`Hiiiiii thanks for stopping by HyperWolfie >_0
              I'm Sam and welcome to my corner of the internet...I have a lot of plans for
              the site and it is mainly a huge WIP right now but I'll slowly add things in my free time!
              `}
            </p>
            <img
              src={grassField.src}
              alt="strip of grass"
              class="h-24 justify-self-end"
            />
          </div>
        </main>
        <div class="hidden md:block flex-1">
          <img
            src={waterfall.src}
            alt="waterfall"
            class="h-full drop-shadow-[0px_3px_2px_rgba(0,0,0,1)]"
          />
          <img
            src={wolfPackHowl.src}
            alt="Howling wolves"
            class="absolute self-end h-24 drop-shadow-[0px_3px_2px_rgba(0,0,0,1)]"
          />
        </div>
      </div>
    </div>
  </div>
  <div class="md:hidden self-center">
    <img
      src={waterfall.src}
      alt="waterfall"
      class="h-full drop-shadow-[0px_3px_2px_rgba(0,0,0,1)]"
    />
    <img
      src={wolfPackHowl.src}
      alt="Howling wolves"
      class="h-20 shrink-0 absolute self-end drop-shadow-[0px_3px_2px_rgba(0,0,0,1)]"
    />
  </div>
</Layout>
