---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { getFeed } from "../lib/posts";
import SideNav from "../components/SideNav.astro";
import wolfieRun from "../assets/images/wolfie-run.gif";
import wolfWalk from "../assets/images/wolf-walk.gif";
import forestBanner from "../assets/images/forest-banner.jpg";
import Header from "../components/Header.astro";

const feed = await getFeed();

const bio = await getEntry("site", "bio");
const { Content: BioContent } = await render(bio!);
---

<Layout>
  <Header
    backgroundSrc={forestBanner.src}
    decorationSrc={wolfieRun.src}
    text="HyperWolfie"
  />
  <div class="flex flex-row justify-between w-full gap-5">
    <SideNav />
    <div class="flex flex-col gap-5 w-1/2">
      <main class="relative">
        <div
          class="outline-solid outline-theme-dark bg-light h-50 p-5 rounded-xs relative"
        >
          <div
            class="outline-dotted outline-background h-full rounded-xs overflow-x-scroll p-2"
          >
            <img
              src={wolfWalk.src}
              alt="A gif of a wolf walking"
              class="float-left w-20"
            />
            <BioContent />
          </div>
        </div>
        <div class="masking-tape"></div>
      </main>
      <div class="bg-light h-50 p-5 rounded-xs"></div>
    </div>
    <div class="w-3/12">
      <div class="bg-light">MENU</div>
    </div>
  </div>
</Layout>
