---
import { getFeed, type Post } from "../../lib/posts";
import type { GetStaticPaths } from "astro";
import { getWebmentions } from "../../server/getWebmentions";
import { parse } from "node-html-parser";
import { formatDateTime } from "../../utils/formatters";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { undefined } from "astro:schema";

export const getStaticPaths = (async ({ paginate }) => {
  const feed = await getFeed();
  return paginate(feed, { pageSize: 1, props: { feed } });
}) satisfies GetStaticPaths;

const { page, feed } = Astro.props;


let postData: PostData | null = null;

if(feed.length > 0) {

const firstPost = page.data[0];

// Page size is 1, so its ok to use the first post
  const root = parse(firstPost.rendered?.html ?? "");
  root.querySelectorAll("img").forEach((el) => el.classList.add("u-photo"));
  postData =  {
    id: firstPost.id,
    date: firstPost.data.date,
    dateFormatted: formatDateTime(firstPost.data.date),
    photo: firstPost.data.photo,
    title: firstPost.data.title,
    html: root.toString(),
    tags: firstPost.data.tags,
  } as PostData;
}

---
<BlogLayout postData={postData} feed={feed} page={page}/>