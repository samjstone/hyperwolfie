---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="authorization_endpoint" href="https://hyperwolfie-auth.netlify.app/auth">
		<link rel="token_endpoint" href="https://hyperwolfie-auth.netlify.app/token">
		<link rel="micropub" href="https://hyperwolfie-micropub.netlify.app/micropub">
		<link rel="indieauth-metadata" href="https://hyperwolfie-auth.netlify.app/.well-known/oauth-authorization-server">
		<link rel="webmention" href="https://webmention.io/hyperwolfie.com/webmention" />
		<title>HyperWolfie</title>
	</head>
	<body class="bg-background">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
