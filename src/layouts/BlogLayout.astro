
---
import PostListDropdowns from "../components/PostListDropdowns.astro";
import PostWebmentions from "../components/PostWebmentions.astro";
import Layout from "./Layout.astro";
import wolfYell from "../assets/images/wolf-yell.gif";
import linedPaper from "../assets/backgrounds/lined-paper.jpg";
import type { Post } from "../lib/posts";
import type { Webmention } from "../types/webmentions";

interface BlogProps {
    post: PostData;
    feed: Post[];
    webmentions: Webmention[];
    page: {
        url: {
            prev: string | null;
            next: string | null;
        };
    } | null;
}


 const { post, feed, webmentions, page } = Astro.props as BlogProps;

const nextFeedPost =  feed.at(feed.findIndex((p) => p.id === post.id) + 1) || null;
const nextPostUrl =page?.url.next ?? `${Astro.url.origin}/${nextFeedPost?.id}`; ; 

const prevFeedPost =  feed.at(feed.findIndex((p) => p.id === post.id) - 1) || null;
const prevPostUrl = page?.url.prev ?? `${Astro.url.origin}/${prevFeedPost?.id}`; 
---

<Layout styles="overflow-y-clip">
  <img
    class="absolute bottom-0 left-0 h-50 height-2"
    src={wolfYell.src}
    alt="Wolf yelling gif"
  />
  <h1
    class="font-title text-[5rem] z-10 text-theme-orange drop-shadow-md drop-shadow-black absolute top-3 left-47"
  >
    Blog
  </h1>
  <div class="h-screen w-full flex justify-center items-center">
    <div
      class="chat-bubble relative bg-light w-[80%] h-[80%] p-12 rounded-sm border-solid border-2 border-black flex flex-col justify-center items-center"
    >
      <div class="w-full h-full rounded flex gap-7">
        <div class="flex flex-col w-5/8">
          <div
            class="flex justify-between flex-col bg-cover border-2 border-dotted border-black h-full overflow-y-scroll p-5 scrollbar-thumb-theme-orange scrollbar-track-theme-green"
            style={`background-image: url(${linedPaper.src})`}
          >
         <div>
                  <a
                    class="u-url"
                    href={`https://hyperwolfie.com/${post.id}`}
                    hidden
                  />
                  <div />
                  <div class="pb-2 text-right">
                    <time
                      class="dt-published text-theme-orange font-bold "
                      datetime={post.date.toISOString()}
                    >
                      {post.dateFormatted}
                    </time>
                  </div>
                  <div set:html={post.html.toString()} />
                </div>
              </div>
          <div class="mt-2 flex font-bold justify-between text-theme-dark">
            {
              prevPostUrl ? (
                <a
                  href={prevPostUrl}
                  class=" hover:underline hover:text-theme-orange"
                >
                  ← Newer
                </a>
              ) : (
                <div />
              )
            }

            {
              nextPostUrl && (
                <a
                  href={nextPostUrl}
                  class=" hover:underline hover:text-theme-orange"
                >
                  Older →
                </a>
              )
            }
          </div>
        </div>
        <div class="w-3/8 h-full gap-3 flex flex-col">
          <div class="p-3 border-black border-solid border-3 h-5/8">
            <PostListDropdowns feed={feed} />
          </div>

          <div class="p-3 border-black border-solid border-3 h-3/8">
            <PostWebmentions
              webmentions={webmentions ?? []}
            />
          </div>
        </div>
      </div>
    </div>
  </div></Layout
>