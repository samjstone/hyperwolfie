---
import PostWebmentions from "../components/PostWebmentions.astro";
import Layout from "./Layout.astro";
import wolfYell from "../assets/images/wolf-yell.gif";
import linedGreen from "../assets/backgrounds/lined-green.gif";
import dirt from "../assets/backgrounds/dirt.jpg";
import grassHills from "../assets/backgrounds/grass-hills.jpg";
import mountainForest from "../assets/backgrounds/mountain-forest.jpg";
import wolfHowlMini from "../assets/images/wolf-howl-mini.gif";
import leaves from "../assets/images/leaves.png";
import type { Post } from "../lib/posts";
import type { Page } from "astro";
import Calendar from "../components/Calendar.astro";
import DropdownButton from "../components/DropdownButton.astro";
import Comments from "../components/Comments.astro";
import CommentCount from "../components/CommentCount.astro";

interface BlogProps {
  postData?: PostData;
  feed: Post[];
  page: Page<Post> | null;
  showInteractions: boolean;
}

const { postData, feed, page, showInteractions } = Astro.props as BlogProps;

const nextFeedPost =
  feed.at(feed.findIndex((p) => p.id === postData?.id) + 1) || null;
const nextPostUrl =
  page?.url.next ?? (nextFeedPost ? `/${nextFeedPost?.id}/` : null);

const prevFeedPostIndex = feed.findIndex((p) => p.id === postData?.id) - 1;
const prevFeedPost = prevFeedPostIndex >= 0 ? feed.at(prevFeedPostIndex) : null;
const prevPostUrl =
  page?.url.prev ?? (prevFeedPost ? `/${prevFeedPost?.id}/` : null);
---

<style>
  .postContainer :global(img) {
    align-self: center;
    height: 90%;
    width: max-content;
    border-color: var(--color-theme-dark);
    border-width: 3px;
    border-style: dotted;
    border-radius: 5px;
  }

  .postContainer :global(h1) {
    font-weight: bold;
    font-size: x-large;
    color: var(--color-theme-blue);
    font-family: "Macondo";
  }
</style>

<Layout styles=" items-center p-3 pt-16 lg:p-0">
  <div
    class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
    style=`background-image: url(${mountainForest.src})`
  >

  </div>
  <div
    class="flex-col gap-5 lg:h-full w-full flex justify-center items-center lg:mt-25"
  >
    <div
      class="relative w-full lg:w-[80%] lg:m-0 flex flex-col justify-center items-center"
    >
      <div
        class="w-full lg:h-[80vh] bg-light p-5 sm:p-8 md:p-12 rounded-sm border-solid border-2 border-black"
        style={`
          border-image-source: url(${leaves.src});
          border-image-slice: 591 658 27 308;
          border-image-width: 32px 45px 20px 24px;
          border-image-repeat: repeat round;
          `}
      >
        <a href="/blog/" class="hover:pointer">
          <h1
            class="font-title text-7xl z-10 text-theme-orange drop-shadow-md drop-shadow-black absolute -top-12 left-3"
          >
            Blog
          </h1>
        </a>
        <div
          class="absolute -top-18 left-0 text-theme-green z-10 font-bold text-sm"
        >
          <a href="/" class="hover:underline">
            {`<- Home`}
          </a>
        </div>
        <div
          class="w-full flex-col lg:flex-row h-full rounded flex gap-4 lg:gap-7"
        >
          <div class="lg:hidden pt-5">
            <DropdownButton label="Entries 🐾" id="calendar">
              <div
                class="relative overflow-scroll bg-cover flex justify-center h-90 p-5 border-black border-double border-4 lg:h-7/8 [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-white [&::-webkit-scrollbar-thumb]:bg-theme-blue [&::-webkit-scrollbar-thumb]:border-sm"
                style={`background-image: url(${grassHills.src})`}
              >
                <img
                  src={wolfHowlMini.src}
                  class="w-30 absolute top-0 right-0 z-1 drop-shadow-lg drop-shadow-theme-blue"
                />
                <Calendar feed={feed} id="dropdown-calendar" />
              </div>
            </DropdownButton>
          </div>
          <div class="flex flex-col w-full lg:w-7/8">
            <div
              class="flex bg-white justify-between flex-col bg-fixed border-2 border-dotted border-black h-[calc(100vh-190px)] lg:h-full overflow-y-scroll p-3 md:p-5 [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-white [&::-webkit-scrollbar-thumb]:bg-theme-orange [&::-webkit-scrollbar-thumb]:border-sm"
              style={`background-image: url(${linedGreen.src})`}
            >
              <div class="h-full">
                {
                  postData ? (
                    <div class="h-entry h-full">
                      <a
                        class="u-url"
                        href={new URL(`/${postData.id}/`, Astro.site).href}
                        hidden
                      />
                      <div />
                      <div class="pb-2 flex gap-2 justify-end">
                        <a
                          href={`/${postData.id}/`}
                          class="text-theme-orange font-bold hover:underline"
                        >
                          <time
                            datetime={postData.date.toISOString()}
                            class="dt-published"
                          >
                            {postData.dateFormatted}
                          </time>
                        </a>
                        <a href={`/${postData.id}/#comments`} class="underline">
                          <CommentCount postId={postData.id} /> 
                        </a>

                      </div>
                      <a
                        href={`/${postData.id}/`}
                        class="hover:underline p-name mb-3 font-extrabold text-3xl font-fredoka text-theme-green"
                      >
                        {postData.title}
                      </a>
                      <div
                        class="e-content postContainer h-full flex flex-col gap-5"
                        set:html={postData.html.toString()}
                      />
                      <a
                        class="u-bridgy-fed"
                        href="https://fed.brid.gy/"
                        hidden="from-humans"
                      />
                      <a
                        class="p-author h-card hidden"
                        href="https://hyperwolfie.com/"
                      >
                        HyperWolfie
                      </a>

                    </div>
                  ) : (
                    <p>No posts yet....</p>
                  )
                }

              </div>
            </div>
            <div class="mt-2 flex font-bold justify-between text-theme-dark">
              {
                prevPostUrl ? (
                  <a
                    href={prevPostUrl}
                    class=" hover:underline hover:text-theme-orange"
                  >
                    ← Newer
                  </a>
                ) : (
                  <div />
                )
              }

              {
                nextPostUrl && (
                  <a
                    href={nextPostUrl}
                    class=" hover:underline hover:text-theme-orange"
                  >
                    Older →
                  </a>
                )
              }
            </div>
          </div>
          <div
            class="lg:w-3/8 flex-col-reverse lg:h-full gap-3 flex lg:flex-col"
          >
            <div
              class="hidden relative overflow-y-scroll bg-cover lg:flex justify-center h-90 p-5 border-black border-double border-4 lg:h-7/8 [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-white [&::-webkit-scrollbar-thumb]:bg-theme-blue [&::-webkit-scrollbar-thumb]:border-sm"
              style={`background-image: url(${grassHills.src})`}
            >
              <img
                src={wolfHowlMini.src}
                class="w-30 absolute top-0 right-0 z-1 drop-shadow-lg drop-shadow-theme-blue"
              />
              <div transition:persist="calendar" class="z-10">
                <Calendar feed={feed} id="normal-calendar" />
              </div>
            </div>

            <div
              class="p-3 text-white border-black bg-repeat border-3 h-2/8 overflow-y-scroll [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-theme-dark [&::-webkit-scrollbar-thumb]:bg-theme-blue [&::-webkit-scrollbar-thumb]:border-sm"
              style={`background-image: url(${dirt.src}); border-style: ridge`}
            >
              <h3 class="font-bold text-theme-yellow">Tags</h3>
              {postData?.tags.map((tag) => <div class="w-fit">#{tag}</div>)}
            </div>
          </div>
        </div>
      </div>
    </div>
    {showInteractions === true && postData ? (

    <div class="relative rounded-sm bg-light w-full lg:w-[80%] self-center py-5 px-12" id="comments">
      <div class="mb-5">

      <PostWebmentions postId={postData.id} server:defer>
        <span
          class="loading loading-dots loading-md"
          slot="fallback"
        />
      </PostWebmentions>
      </div>

      <h2 class="font-bold text-theme-blue text-xl">Comments</h2>
      <Comments server:defer />
      <img
        class="hidden md:block absolute -bottom-14 md:-left-18 lg:-left-32 h-40 lg:h-50 -z-1"
        src={wolfYell.src}
        alt="Wolf yelling gif"
      />
    </div>
    ) : <></>}
  </div>
</Layout>
