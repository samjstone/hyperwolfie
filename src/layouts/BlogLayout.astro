---
import PostListDropdowns from "../components/PostListDropdowns.astro";
import PostWebmentions from "../components/PostWebmentions.astro";
import Layout from "./Layout.astro";
import wolfYell from "../assets/images/wolf-yell.gif";
import linedPaper from "../assets/backgrounds/lined-paper.jpg";
import dirt from "../assets/backgrounds/dirt.jpg";
import grassHills from "../assets/backgrounds/grass-hills.jpg";
import mountainForest from "../assets/backgrounds/mountain-forest.jpg";
import wolfHowlMini from "../assets/images/wolf-howl-mini.gif";
import leaves from "../assets/images/leaves.png";
import type { Post } from "../lib/posts";
import type { Webmention } from "../types/webmentions";
import type { Page } from "astro";
import Calendar from "../components/Calendar.astro";

interface BlogProps {
  post: PostData;
  feed: Post[];
  webmentions: Webmention[];
  page: Page<Post> | null;
}

const { post, feed, webmentions, page } = Astro.props as BlogProps;

const nextFeedPost =
  feed.at(feed.findIndex((p) => p.id === post.id) + 1) || null;
const nextPostUrl =
  page?.url.next ?? (nextFeedPost ? `/${nextFeedPost?.id}` : null);

const prevFeedPostIndex = feed.findIndex((p) => p.id === post.id) - 1;
const prevFeedPost = prevFeedPostIndex >= 0 ? feed.at(prevFeedPostIndex) : null;
const prevPostUrl =
  page?.url.prev ?? (prevFeedPost ? `/${prevFeedPost?.id}` : null);
---

<Layout
  styles="overflow-y-clip bg-cover bg-no-repeat bg-center"
  bgImage={mountainForest.src}
>
  <img
    class="absolute bottom-0 left-0 h-50 height-2"
    src={wolfYell.src}
    alt="Wolf yelling gif"
  />
  <a href="/blog" class="hover:pointer">
    <h1
      class="font-title text-[5rem] z-10 text-theme-orange drop-shadow-md drop-shadow-black absolute top-6 left-47"
    >
      Blog
    </h1>
  </a>
  <div class="h-screen w-full flex justify-center items-center mt-3">
    <div
      class="chat-bubble relative bg-light w-[80%] h-[80%] p-12 rounded-sm border-solid border-2 border-black flex flex-col justify-center items-center"
      style={`
      border-image-source: url(${leaves.src});
border-image-slice: 591 658 27 308;
border-image-width: 32px 45px 20px 24px;
border-image-repeat: repeat round;
      `}
    >
      <div
        class="fixed self-start -ml-12 top-0 text-white z-10 font-bold text-[1rem] p-3"
      >
        <a href="/" class="hover:underline">
          {`<- Home`}
        </a>
      </div>
      <div class="w-full h-full rounded flex gap-7">
        <div class="flex flex-col w-5/8">
          <div
            class="flex justify-between flex-col bg-cover border-2 border-dotted border-black h-full overflow-y-scroll p-5 [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-white [&::-webkit-scrollbar-thumb]:bg-theme-orange [&::-webkit-scrollbar-thumb]:border-sm"
            style={`background-image: url(${linedPaper.src})`}
          >
            <div>
              <a
                class="u-url"
                href={`https://hyperwolfie.com/${post.id}`}
                hidden></a>
              <div></div>
              <div class="pb-2 text-right">
                <time
                  class="dt-published text-theme-orange font-bold"
                  datetime={post.date.toISOString()}
                >
                  {post.dateFormatted}
                </time>
              </div>
              <div set:html={post.html.toString()} />
            </div>
          </div>
          <div class="mt-2 flex font-bold justify-between text-theme-dark">
            {
              prevPostUrl ? (
                <a
                  href={prevPostUrl}
                  class=" hover:underline hover:text-theme-orange"
                >
                  ← Newer
                </a>
              ) : (
                <div />
              )
            }

            {
              nextPostUrl && (
                <a
                  href={nextPostUrl}
                  class=" hover:underline hover:text-theme-orange"
                >
                  Older →
                </a>
              )
            }
          </div>
        </div>
        <div class="w-3/8 h-full gap-3 flex flex-col">
          <img
            src={wolfHowlMini.src}
            class="w-30 absolute right-12 z-1 drop-shadow-lg drop-shadow-theme-blue"
          />
          <div
            class="relative overflow-y-scroll bg-cover flex justify-center p-5 border-black border-double border-4 h-7/8 [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-white [&::-webkit-scrollbar-thumb]:bg-theme-blue [&::-webkit-scrollbar-thumb]:border-sm"
            style={`background-image: url(${grassHills.src})`}
          >
            <div transition:persist="calendar" class="z-10">
              <Calendar feed={feed} />
            </div>
          </div>

          <div
            class="p-3 text-white border-black bg-repeat border-3 h-2/8 overflow-y-scroll [&::-webkit-scrollbar]:w-3 [&::-webkit-scrollbar-track]:bg-theme-dark [&::-webkit-scrollbar-thumb]:bg-theme-blue [&::-webkit-scrollbar-thumb]:border-sm"
            style={`background-image: url(${dirt.src}); border-style: ridge`}
          >
            <PostWebmentions webmentions={webmentions ?? []} />
          </div>
        </div>
      </div>
    </div>
  </div></Layout
>
